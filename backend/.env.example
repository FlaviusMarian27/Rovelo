# Copiază fișierul ăsta în .env (cp .env.example .env) și schimbă parola.
# .env e în .gitignore: secretele nu ajung niciodată pe GitHub.
# Îl citesc și Docker Compose (pentru baza de date), și Spring Boot (pentru conexiune).

POSTGRES_DB=rovelo
POSTGRES_USER=rovelo
POSTGRES_PASSWORD=change-me

# Cheia cu care se semnează token-urile JWT. Minim 32 de caractere, aleatoare.
# Generezi una cu: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
